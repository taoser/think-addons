{
    "name": "taoser/think-addons",
    "description": "2026,Addons v3.0 is the plugin system for ThinkPHP 8, 用于ThinkPHP8的插件系统，支持中间件、事件、命令、视图等",
    "license": "mit",
    "authors": [
        {
            "name": "taoler",
            "email": "changlin_zhao@qq.com"
        }
    ],
    "require": {
        "php": ">=8.0.0",
        "topthink/framework": "^8.1",
        "topthink/think-view": "^2.0",
        "topthink/think-helper": "^3.0",
        "symfony/var-exporter": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "taoser\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "extra": {
        "think": {
            "services": [
                "taoser\\addons\\Service"
            ],
            "config":{
                "addons": "src/config.php"
            }
        }
    },
    "scripts" : {
        "post-install-cmd": [
            "php think addons:config"
        ]
    }
}
